rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function areFriends(a, b) {
      let id = friendshipId(a, b);
      return isSignedIn()
        && exists(/databases/$(database)/documents/friendships/$(id))
        && get(/databases/$(database)/documents/friendships/$(id)).data.status == 'accepted';
    }

    function isFriendReadable(collection) {
      return collection in ['habits', 'tasks', 'goals', 'schedule'];
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && username.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Signed-in users need profile reads for exact-username search and friends.
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['uid', 'displayName', 'photoUrl', 'username', 'createdAt'])
        && request.resource.data.uid == uid;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'username'])
        && request.resource.data.uid == resource.data.uid
        && (request.resource.data.username == resource.data.username
          || (resource.data.username == null
            && request.resource.data.username is string
            && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')));
      allow delete: if isOwner(uid);

      match /{collection}/{docId} {
        allow read: if isOwner(uid)
          || (isFriendReadable(collection) && areFriends(request.auth.uid, uid));
        allow create, update: if isOwner(uid)
          && (!isFriendReadable(collection) || request.resource.data.id == docId);
        allow delete: if isOwner(uid);
      }
    }

    match /friendRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
          ['fromUid', 'toUid', 'status', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == request.auth.uid + '_' + request.resource.data.toUid;
      allow read: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow delete: if isSignedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow update: if false;
    }

    match /friendships/{id} {
      allow read: if isSignedIn()
        && (resource.data.uid1 == request.auth.uid
          || resource.data.uid2 == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(
          ['uid1', 'uid2', 'status', 'createdAt'])
        && request.resource.data.uid1 is string
        && request.resource.data.uid2 is string
        && request.resource.data.uid1 < request.resource.data.uid2
        && id == request.resource.data.uid1 + '_' + request.resource.data.uid2
        && request.resource.data.status == 'accepted'
        && ((request.auth.uid == request.resource.data.uid1
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.uid2 + '_' + request.auth.uid)))
          || (request.auth.uid == request.resource.data.uid2
            && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.uid1 + '_' + request.auth.uid))));
      allow update: if false;
      allow delete: if isSignedIn()
        && (resource.data.uid1 == request.auth.uid
          || resource.data.uid2 == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
